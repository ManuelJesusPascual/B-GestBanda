# Copy to .env and fill in. docker compose reads .env automatically.

# HMAC key used to sign JWTs. At least 32 bytes. Generate one with: openssl rand -base64 64
JWT_SECRET=

# Imgur Client-ID used to upload band logos (https://api.imgur.com/oauth2/addclient).
# Without it, registering a band fails when uploading the logo.
IMGUR_CLIENT_ID=

# Only needed when running the app outside docker compose.
DB_URL=jdbc:postgresql://localhost:5432/gestbanda
DB_USERNAME=postgres
DB_PASSWORD=postgres
